# Tailscale node auth key — generate one in the Tailscale admin console
# (Access controls -> Keys -> Generate auth key). Reusable/auth-node keys work.
TAILSCALE_AUTH_KEY=tskey-auth-xxxxxxxxxxxx

# MagicDNS name of the app on your tailnet (hostname: bb-app in compose.yaml)
# Leave the domain as-is; it matches your tailnet (tail4fde5e.ts.net).
TS_CERT_DOMAIN=bb-app.tail4fde5e.ts.net

# The bb-app container image — replace with the real registry/image:tag
# (e.g. docker.io/you/bb-app:latest or ghcr.io/you/bb-app:latest)
BB_APP_IMAGE=ghcr.io/example/bb-app:latest

# Port bb-app listens on INSIDE the container
BB_APP_PORT=8080

# Timezone
TZ=America/New_York